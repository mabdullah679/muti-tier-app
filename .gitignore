# Ignore environment variables
.env

# Ignore local build artifacts and dependencies
node_modules/
dist/
build/
coverage/
   
# Ignore Docker Compose, but include Dockerfiles in frontend and backend
docker-compose.yml
/Dockerfile
!backend/Dockerfile
!frontend/Dockerfile

# Ignore logs and temporary files
*.log
*.out
*.o
tmp/
.DS_Store

# Ignore IDE/editor-specific directories and files
.vscode/
.idea/

# Ignore OS-generated files
Thumbs.db
Desktop.ini


# macOS folder-localisation markers
.localized

# Terraform (also covered by terraform/.gitignore)
.terraform/
*.tfstate
*.tfstate.*

# Pages tooling
.wrangler/
playwright-report/
test-results/

# Terraform (infra/cloudflare): never commit state, plans or real variable values
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
*.tfvars
*.tfvars.json
!*.tfvars.example
